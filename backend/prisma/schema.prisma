generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model T_AJUSTE_PONTO {
  TAP_CD_PONTO       Int       @id(map: "PK__T_AJUSTE__805AB33A83DE36FD") @unique(map: "UQ__T_AJUSTE__805AB33BF72022D4") @default(autoincrement())
  TAP_NM_SOLICITACAO String?
  TAP_NM_STATUS      String?
  TAP_NM_DESCRICAO   String?
  TAP_NM_URL         String?
  TAP_DT_INICIAL     DateTime?
  TAP_DT_FINAL       DateTime?
  TAP_BL_APROVADO    Boolean?
}

model T_FUNCIONARIO {
  FUN_CD_USUARIO     Int       @id(map: "PK__T_FUNCIO__84C1360CCFBEA8D2") @unique(map: "UQ__T_FUNCIO__84C1360D7B241534") @default(autoincrement())
  FUN_NM_NOME        String?
  FUN_NM_EMAIL       String?
  FUN_NM_SENHA       String?
  FUN_DT_CRIACAO     DateTime? @default(now())
  FUN_DT_MODIFICACAO DateTime?
}

model T_PONTO {
  PON_CD_PONTO       Int       @id(map: "PK__T_PONTO__0CF3ECE03A7FF45A") @unique(map: "UQ__T_PONTO__0CF3ECE152AD1002") @default(autoincrement())
  PON_NM_PONTO       String?
  PON_NM_ENDERECO    String?
  PON_CD_USUARIO     Int?
  PON_DT_PONTO       DateTime? @default(now())
  PON_DT_MODIFICACAO String?
}
